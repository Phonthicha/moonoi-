/* Body Layout */
body {
    background-image: url('pic/pic6.jpg');
    background-size: cover;
    background-attachment: fixed;
    margin: 0;
    padding: 0;
    font-family: sans-serif;
}

/* Main Table Setup */
.main-table {
    width: 1200px;
    margin: 20px auto;
    border-collapse: collapse;
    border: 1px solid rgba(225, 211, 211, 0.147);
    background-color: rgba(8, 108, 154, 0.934);
    color: #ffffff;
}

/* Base Cells Styling */
td {
    padding: 0;
    text-align: left;
    vertical-align: top;
}

td img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}

/* Header & Marquee */
.header-img-td {
    height: 300px;
}

.move {
    background-color: aqua;
    color: #000000;
    font-weight: bold;
    padding: 5px 0;
}

/* Columns Layout */
.col1 {
    width: 200px;
    padding: 10px;
    box-sizing: border-box;
}

.col2 {
    width: 800px;
    padding: 10px;
    box-sizing: border-box;
}

.col3 {
    width: 200px;
    padding: 10px;
    box-sizing: border-box;
    text-align: center;
}

/* Sub-tables */
.table1 {
    width: 100%;
    margin-bottom: 15px;
}

.table2 {
    width: 100%;
    border-collapse: collapse;
}

.table3 {
    width: 100%;
    margin: 0 auto;
}

.table3 td {
    padding-bottom: 10px;
}

/* Specific Element Styling */
.card-img {
    width: 350px;
    height: 280px;
}

.card-text {
    width: 350px;
    height: 30px;
    text-align: center;
    vertical-align: middle;
    padding-top: 5px;
}

.card-text a {
    color: #ffd700;
}

.spacer {
    width: 20px;
}

.sidebar-title {
    background-color: yellow;
    color: #000000;
    margin: 0 0 10px 0;
    padding: 5px;
}

/* Link List Styling */
.col1 ul {
    padding-left: 20px;
    margin: 0;
}

.col1 ul li {
    margin-bottom: 10px;
}

.col1 a {
    color: #ffffff;
    text-decoration: none;
}

.col1 a:hover {
    text-decoration: underline;
}
